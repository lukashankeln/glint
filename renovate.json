{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>kube-the-home/renovate"
  ],
  "packageRules": [
    {
      "matchFileNames": [
        "test/testdata/**"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "build"
    },
    {
      "matchFileNames": [
        "action.yaml"
      ],
      "enabled": false
    }
  ]
}
